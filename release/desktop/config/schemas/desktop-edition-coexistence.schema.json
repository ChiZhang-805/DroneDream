{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dronedream.local/schemas/desktop-edition-coexistence.v1.json",
  "title": "DroneDream desktop edition side-by-side contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "contractVersion",
    "productDisplayVersion",
    "accountAuthority",
    "sharedResources",
    "legacyDesktop",
    "editions",
    "stateMachineVerification"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "dronedream-desktop-edition-coexistence"},
    "contractVersion": {"const": "1.0.0"},
    "productDisplayVersion": {"const": "1.0.0"},
    "accountAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "projectUrl",
        "sharedAccountSubject",
        "sharedCloudDataAuthorization",
        "desktopSessionSharing",
        "desktopTokenImport"
      ],
      "properties": {
        "provider": {"const": "supabase"},
        "projectUrl": {"const": "https://yggabfynndpzymlqvnim.supabase.co"},
        "sharedAccountSubject": {"const": true},
        "sharedCloudDataAuthorization": {"const": true},
        "desktopSessionSharing": {"const": false},
        "desktopTokenImport": {"const": false}
      }
    },
    "sharedResources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimeBaseName",
        "runtimeOwner",
        "runtimeRemovedByEditionUninstall",
        "webView2Owner",
        "protocolOwnerPolicy",
        "serviceTaskAutorunPolicy"
      ],
      "properties": {
        "runtimeBaseName": {"const": "DroneDreamRuntime"},
        "runtimeOwner": {"const": "runtime-base-manager"},
        "runtimeRemovedByEditionUninstall": {"const": false},
        "webView2Owner": {"const": "microsoft-evergreen-runtime"},
        "protocolOwnerPolicy": {"const": "edition-namespaced"},
        "serviceTaskAutorunPolicy": {"const": "unique-owner-or-edition-namespaced"}
      }
    },
    "legacyDesktop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productName",
        "bundleIdentifier",
        "installRoot",
        "strategy",
        "silentOverwriteAllowed",
        "migrationRequiresOperatorConfirmation",
        "migrationMustPreserveRuntimeAndUserData",
        "unresolvedShortcutConflictBlocksShortcutCreation"
      ],
      "properties": {
        "productName": {"const": "DroneDream"},
        "bundleIdentifier": {"const": "io.dronedream.desktop"},
        "installRoot": {"const": "%LOCALAPPDATA%/DroneDream"},
        "strategy": {"const": "explicit-migration-or-preserved-side-by-side"},
        "silentOverwriteAllowed": {"const": false},
        "migrationRequiresOperatorConfirmation": {"const": true},
        "migrationMustPreserveRuntimeAndUserData": {"const": true},
        "unresolvedShortcutConflictBlocksShortcutCreation": {"const": true}
      }
    },
    "editions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "editionId",
          "artifactFileName",
          "installerProductName",
          "displayName",
          "bundleIdentifier",
          "installRoot",
          "uninstallRegistryKey",
          "productRegistryKey",
          "startMenuFolder",
          "desktopShortcutName",
          "appUserModelId",
          "updaterChannel",
          "updaterMetadataFileName",
          "runtimeProfileId",
          "authClientId",
          "loopbackPathPrefix",
          "customProtocol",
          "credentialVaultNamespace",
          "webViewDataNamespace",
          "brandEditionId",
          "canonicalMark",
          "generatedWindowsIcon"
        ],
        "properties": {
          "editionId": {"enum": ["universal", "sim", "lab", "field", "autonomy"]},
          "artifactFileName": {"pattern": "^DroneDream-(Universal|Sim|Lab|Field|Agent)-1\\.0\\.0\\.exe$"},
          "installerProductName": {"pattern": "^DroneDream-(Universal|Sim|Lab|Field|Agent)$"},
          "displayName": {"type": "string", "minLength": 10},
          "bundleIdentifier": {"pattern": "^io\\.dronedream\\.desktop\\.(universal|sim|lab|field|autonomy)$"},
          "installRoot": {"pattern": "^%LOCALAPPDATA%/DroneDream-(Universal|Sim|Lab|Field|Agent)$"},
          "uninstallRegistryKey": {"type": "string", "minLength": 1},
          "productRegistryKey": {"type": "string", "minLength": 1},
          "startMenuFolder": {"type": "string", "minLength": 1},
          "desktopShortcutName": {"type": "string", "minLength": 10},
          "appUserModelId": {"type": "string", "minLength": 1},
          "updaterChannel": {"enum": ["universal", "sim", "lab", "field", "autonomy"]},
          "updaterMetadataFileName": {"pattern": "^latest-(universal|sim|lab|field|autonomy)\\.json$"},
          "runtimeProfileId": {"type": "string", "minLength": 1},
          "authClientId": {"pattern": "^dronedream-desktop-(universal|sim|lab|field|autonomy)$"},
          "loopbackPathPrefix": {"pattern": "^/desktop-auth/(universal|sim|lab|field|autonomy)/$"},
          "customProtocol": {"pattern": "^dronedream-(universal|sim|lab|field|autonomy)$"},
          "credentialVaultNamespace": {"pattern": "^DroneDream/Auth/(universal|sim|lab|field|autonomy)/v1$"},
          "webViewDataNamespace": {"type": "string", "minLength": 1},
          "brandEditionId": {"enum": ["universal", "sim", "lab", "field", "autonomy"]},
          "canonicalMark": {"type": "string", "minLength": 1},
          "generatedWindowsIcon": {"type": "string", "minLength": 1}
        }
      }
    },
    "stateMachineVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installOrderCoverage", "requiredStates", "releaseRequiresExecutedReceipt"],
      "properties": {
        "installOrderCoverage": {"const": "pairwise-plus-all-five"},
        "requiredStates": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "all-five-installed",
              "each-edition-upgraded-in-place",
              "each-edition-uninstalled-alone",
              "remaining-four-still-launchable",
              "legacy-detected-without-overwrite"
            ]
          }
        },
        "releaseRequiresExecutedReceipt": {"const": true}
      }
    }
  }
}
