# Local API/runtime
VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional cloud accounts. Leave both blank to keep local-only mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_TURNSTILE_SITE_KEY=
# Optional explicit overrides. When blank, both URLs are derived from
# VITE_SUPABASE_URL as /functions/v1/model-gateway and
# /functions/v1/billing-checkout.
VITE_MODEL_GATEWAY_URL=
VITE_BILLING_CHECKOUT_URL=

# Social providers are exposed in browser builds only after the matching
# provider is enabled in Supabase. Desktop editions open this browser flow and
# return through their edition-specific loopback callback.
VITE_AUTH_GOOGLE_ENABLED=false
VITE_AUTH_GITHUB_ENABLED=false
VITE_AUTH_SLACK_ENABLED=false
VITE_AUTH_APPLE_ENABLED=false
