{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DroneDream-Universal",
  "identifier": "io.dronedream.desktop.universal",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DroneDream",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 700,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "decorations": true,
        "fullscreen": false,
        "theme": "Light",
        "backgroundColor": "#ffffff"
      }
    ]
  },
  "bundle": {
    "publisher": "DroneDream",
    "shortDescription": "Unified DroneDream workspace for SIM, LAB, FIELD and AGENT workflows",
    "longDescription": "DroneDream Universal uses one shared core and presentation-only SIM, LAB, FIELD and AGENT workspace modes. Hardware actions remain unavailable unless installed modules, a validated Vehicle Pack, and native, backend and Runtime policy all authorize the exact action.",
    "externalBin": [
      "../src/binaries/dronedream-autonomy-core",
      "../src/binaries/dronedream-plugin-isolator",
      "../src/binaries/dronedream-live"
    ],
    "icon": [
      "../src/gen/brand/universal/windows/32x32.png",
      "../src/gen/brand/universal/windows/128x128.png",
      "../src/gen/brand/universal/windows/128x128@2x.png",
      "../src/gen/brand/universal/windows/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "../src/gen/brand/universal/windows/icon.ico",
        "uninstallerIcon": "../src/gen/brand/universal/windows/icon.ico"
      }
    },
    "resources": {
      "../src/agent-core-resources/runtime": "agent-core/runtime",
      "../src/agent-core-resources/official-plugins": "agent-core/official-plugins",
      "../src/agent-core-resources/default-assets": "agent-core/default-assets",
      "../src/agent-core-resources/agent-core-stage.json": "agent-core/agent-core-stage.json",
      "../src/agent-core-resources/core-components-build.json": "agent-core/core-components-build.json",
      "../src/agent-core-resources/dronedream-plugin-isolator.exe": "agent-core/dronedream-plugin-isolator.exe",
      "../../../release/desktop/config/build-profiles/universal-1.0.0.v1.json": "distribution/universal-build-profile.v1.json",
      "../../../release/desktop/config/capabilities/core-capabilities.v1.json": "distribution/capabilities/core-capabilities.v1.json",
      "../../../release/desktop/config/editions/sim.v1.json": "distribution/editions/sim.v1.json",
      "../../../release/desktop/config/editions/lab.v1.json": "distribution/editions/lab.v1.json",
      "../../../release/desktop/config/editions/field.v1.json": "distribution/editions/field.v1.json",
      "../../../release/desktop/config/editions/autonomy.v1.json": "distribution/editions/autonomy.v1.json",
      "../../../release/desktop/config/safety/edition-execution-gate.v1.json": "distribution/safety/edition-execution-gate.v1.json",
      "../../../release/desktop/config/vehicle-packs/registry.v1.json": "distribution/vehicle-packs/registry.v1.json",
      "../../../release/desktop/config/updates/edition-coexistence.v1.json": "distribution/desktop/edition-coexistence.v1.json",
      "../../../release/desktop/config/updates/edition-browser-auth.v1.json": "distribution/desktop/edition-browser-auth.v1.json",
      "../../../release/desktop/config/updates/edition-runtime-update-families.v1.json": "distribution/desktop/edition-runtime-update-families.v1.json",
      "../../../shared/brand/editions.json": "brand/editions.json"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ChiZhang-805/DroneDream/releases/download/desktop-universal-channel/latest-universal.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
