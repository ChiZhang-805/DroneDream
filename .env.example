# DroneDream environment template.
# Copy to .env and edit for local development. Do not commit real secrets.

# --- Backend (FastAPI) ---
# Host/port the API listens on.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Application environment: development | test | production
APP_ENV=development

# CORS: comma-separated origins allowed by the API.
CORS_ORIGINS=http://localhost:5173

# Database URL. SQLite for local MVP; swap for Postgres later.
DATABASE_URL=sqlite:///./drone_dream.db
# Keep true for local SQLite convenience. Production should run Alembic and
# set this false so application startup never mutates the schema implicitly.
DATABASE_AUTO_CREATE=true

# Authentication. APP_ENV=production refuses AUTH_MODE=disabled.
AUTH_MODE=disabled
# Development-only token mapping: email:token,email:token
DEMO_AUTH_TOKENS=
# Internet-facing mode: validate asymmetric OIDC access tokens by issuer,
# audience, expiration and JWKS signature. Configure the frontend login flow
# with the same identity provider; never put a client secret in Vite variables.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ALGORITHMS=RS256,ES256
OIDC_EMAIL_CLAIM=email
OIDC_NAME_CLAIM=name
OIDC_CLOCK_SKEW_SECONDS=30

# Optional Redis/Valkey worker-presence signal. Production readiness should
# require this so the API cannot report ready with no simulator worker.
REDIS_URL=
REQUIRE_WORKER_HEARTBEAT=false
WORKER_PRESENCE_INTERVAL_SECONDS=10
WORKER_PRESENCE_TTL_SECONDS=45

# Packaged desktop runtime identity and executable checks. Leave these blank
# for ordinary web/development mode. When DRONEDREAM_RUNTIME_ID is configured,
# readiness also requires REDIS_URL with a live worker heartbeat and both
# executable paths below.
DRONEDREAM_RUNTIME_ID=
DRONEDREAM_PX4_EXECUTABLE=
DRONEDREAM_GAZEBO_EXECUTABLE=

# Log level: debug | info | warning | error
LOG_LEVEL=info

# --- Worker ---
# How often the worker polls the DB queue for trial work, in seconds.
WORKER_POLL_INTERVAL_SECONDS=1.0

# Worker log level (defaults to LOG_LEVEL if unset).
WORKER_LOG_LEVEL=info

# Renewable trial leases and stale-attempt fencing.
WORKER_LEASE_SECONDS=900
WORKER_LEASE_HEARTBEAT_SECONDS=30
WORKER_STALE_RUNNING_RECLAIM_ENABLED=true

# Artifact storage: local for development, S3-compatible for production.
ARTIFACT_STORAGE_BACKEND=local
ARTIFACT_ROOT=./artifacts
# Local cleanup is opt-in and defaults to dry-run. It only scans the
# DroneDream-managed ARTIFACT_ROOT/jobs and REAL_SIMULATOR_ARTIFACT_ROOT/jobs
# subtrees; S3 deployments should use bucket lifecycle policies instead.
ARTIFACT_CLEANUP_ENABLED=false
ARTIFACT_CLEANUP_DRY_RUN=true
ARTIFACT_CLEANUP_INTERVAL_SECONDS=3600
# 0 disables the corresponding total-size or maximum-age limit.
ARTIFACT_RETENTION_MAX_TOTAL_BYTES=0
ARTIFACT_RETENTION_MAX_AGE_SECONDS=0
# Capacity pressure cannot evict artifacts newer than this floor.
ARTIFACT_RETENTION_MIN_AGE_SECONDS=86400
# Recent terminal jobs and every active job are always protected.
ARTIFACT_RETENTION_KEEP_RECENT_TERMINAL_JOBS=20
# Unreferenced managed files must age beyond this grace period before removal.
ARTIFACT_ORPHAN_GRACE_SECONDS=86400
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=dronedream/
S3_CONNECT_TIMEOUT_SECONDS=10
S3_READ_TIMEOUT_SECONDS=60
S3_MAX_ATTEMPTS=3
ARTIFACT_PRESIGN_EXPIRY_SECONDS=900

# Simulator backend selection (global override).
# Supported: mock | real_stub | real_cli
# - mock: deterministic in-process simulator used by the MVP (Phase 4).
# - real_stub: placeholder that always returns ADAPTER_UNAVAILABLE (Phase 4).
# - real_cli: subprocess adapter that invokes REAL_SIMULATOR_COMMAND with a
#   JSON file protocol. See docs/08-px4-gazebo.md.
#
# IMPORTANT — leave this UNSET (blank) for normal use. When blank, each job
# uses its own ``simulator_backend`` field (selected in the New Job UI).
# Setting a value here OVERRIDES every job's selection globally and is only
# intended for back-compat with Phase 7 deployments or for forcing all jobs
# through a specific backend during debugging.
#
# Examples (uncomment at most one):
# SIMULATOR_BACKEND=mock
# SIMULATOR_BACKEND=real_cli
# SIMULATOR_BACKEND=real_stub
SIMULATOR_BACKEND=

# --- Phase 8: real_cli simulator adapter ---
# Full command line to invoke the external simulator. May contain
# ``{input}`` / ``{output}`` placeholders; otherwise ``--input <path>
# --output <path>`` is appended automatically.
REAL_SIMULATOR_COMMAND=
# Working directory for the subprocess (defaults to the trial run dir).
REAL_SIMULATOR_WORKDIR=
# Base wall-clock timeout per trial at speed factor 1. Factors below 1 expand
# the effective timeout by 1/factor, capped at 10x.
REAL_SIMULATOR_TIMEOUT_SECONDS=300
# Root directory under which per-job/per-trial run dirs are created.
REAL_SIMULATOR_ARTIFACT_ROOT=./artifacts
# When true, run dirs are retained after the trial finishes (for debugging).
REAL_SIMULATOR_KEEP_RUN_DIRS=true

# --- Phase 8: PX4/Gazebo external runner (used by real_cli) ---
# Configure REAL_SIMULATOR_COMMAND to point at:
#   python3 /abs/path/scripts/simulators/px4_gazebo_runner.py
#
# The runner can execute a real site-specific launcher command OR run in
# deterministic dry-run mode for CI/dev machines without PX4/Gazebo.
# Launch command templates may use tokens such as:
# {run_dir} {trial_input} {trial_output} {params_json} {track_json}
# {telemetry_json} {trajectory_json} {stdout_log} {stderr_log} {job_id}
# {trial_id} {candidate_id} {seed} {scenario_type} {vehicle} {airframe}
# {simulator_model} {world} {px4_version}
# {headless} {extra_args}
PX4_GAZEBO_LAUNCH_COMMAND=
PX4_GAZEBO_WORKDIR=
PX4_GAZEBO_TIMEOUT_SECONDS=300
PX4_GAZEBO_HEADLESS=true
PX4_GAZEBO_KEEP_RAW_LOGS=true
PX4_GAZEBO_DRY_RUN=false
PX4_GAZEBO_PASS_RMSE=0.75
PX4_GAZEBO_PASS_MAX_ERROR=2.0
PX4_GAZEBO_MIN_TRACK_COVERAGE=0.9
PX4_GAZEBO_VEHICLE=
PX4_GAZEBO_WORLD=
PX4_GAZEBO_EXTRA_ARGS=
PX4_GAZEBO_TELEMETRY_FORMAT=json
PX4_GAZEBO_ALLOW_CSV_TELEMETRY=false
# Fail closed by default when requested effects are not physically injected.
# Enabling this only permits metadata passthrough and still forces pass=false.
PX4_GAZEBO_ALLOW_UNVERIFIED_ADVANCED_EFFECTS=false

# Optional site-specific lower-level wrapper settings for
# scripts/simulators/local_px4_launch_wrapper.py
PX4_AUTOPILOT_DIR=
# Optional full 40-character SHA evidence for a custom/remote launcher without
# a local PX4_AUTOPILOT_DIR checkout.
PX4_FIRMWARE_COMMIT_OBSERVED=
PX4_SETUP_COMMANDS=
PX4_LAUNCH_COMMAND_TEMPLATE=
# Optional operator override. Leave blank to derive gz_* from each job's
# vehicle_profile.simulator_model. Set PX4_FORCE_MAKE_TARGET=true only for a
# site that intentionally ignores the per-job model.
PX4_MAKE_TARGET=
PX4_FORCE_MAKE_TARGET=false
PX4_RUN_SECONDS=30
PX4_READY_TIMEOUT_SECONDS=30
PX4_SITE_DRY_RUN=false
PX4_TELEMETRY_MODE=json
PX4_TELEMETRY_SOURCE_JSON=
PX4_ULOG_ROOT=
PX4_ULOG_PATH=
PX4_ENABLE_OFFBOARD_EXECUTOR=true
PX4_OFFBOARD_EXECUTOR_COMMAND=
PX4_OFFBOARD_CONNECTION=udp://:14540
PX4_OFFBOARD_SETPOINT_RATE_HZ=10
PX4_OFFBOARD_TAKEOFF_TIMEOUT_SECONDS=30
PX4_OFFBOARD_TRACK_TIMEOUT_SECONDS=120
PX4_OFFBOARD_LAND_AFTER=true
PX4_OFFBOARD_DRY_RUN=false
# Catalog-backed PX4 parameter application/readback transport.
PX4_PARAMETER_TRANSPORT=environment
PX4_PARAMETER_CONNECTION=udp://:14540
PX4_PARAMETER_TIMEOUT_SECONDS=15
PX4_PARAMETER_ENFORCE_SAFE_BOUNDS=true
PX4_GAZEBO_LAUNCH_GUI_CLIENT=false
# Leave PX4_GAZEBO_GUI_COMMAND blank to use the bundled wrapper default.
# If explicitly set, prefer /workspace/DroneDream/scripts/simulators/gazebo_gui_client.sh (not raw "gz sim -g").
PX4_GAZEBO_GUI_COMMAND=
PX4_GAZEBO_RAW_GUI_COMMAND="gz sim -g"
PX4_GAZEBO_GUI_START_DELAY_SECONDS=5
PX4_GAZEBO_GUI_WAIT_TIMEOUT_SECONDS=15
PX4_GAZEBO_REQUIRE_GUI_CLIENT=false
PX4_GAZEBO_DRAW_TRACK_MARKER=false
PX4_GAZEBO_TRACK_MARKER_COMMAND=
PX4_GAZEBO_TRACK_MARKER_START_DELAY_SECONDS=2
PX4_GAZEBO_REQUIRE_TRACK_MARKER=false
PX4_GAZEBO_TRACK_MARKER_Z_OFFSET=0.03
PX4_GAZEBO_TRACK_MARKER_COLOR="0 0.8 1 1"
PX4_GAZEBO_TRACK_MARKER_LINE_WIDTH=0.08
PX4_GAZEBO_TRACK_MARKER_MODE=line_strip
LIBGL_ALWAYS_SOFTWARE=1
QT_X11_NO_MITSHM=1

# --- Phase 8: GPT parameter proposer ---
# Fernet key used to encrypt per-job OpenAI API keys at rest. REQUIRED if any
# job uses ``optimizer_strategy=gpt``. Must be visible to BOTH the backend
# process (so job creation can encrypt the key) AND the worker process (so it
# can decrypt and call OpenAI). Recommended local setup: put it in this
# root-level .env (sourced by both dev scripts), or export it in both terminals.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY=
# Maximum lifetime for an encrypted per-job LLM credential (default: 24h).
JOB_SECRET_TTL_SECONDS=86400
JOB_SECRET_CLEANUP_INTERVAL_SECONDS=60
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
LLM_MAX_RESPONSE_BYTES=1000000
LLM_MAX_PROMPT_BYTES=262144
FINALIZATION_LEASE_SECONDS=900
SQLITE_BUSY_TIMEOUT_SECONDS=30
# Default OpenAI model to use when a job does not specify one.
OPENAI_MODEL=gpt-4.1
# Comma-separated HTTPS origins allowed for user-supplied OpenAI-compatible
# endpoints in production, for example https://api.deepseek.com,https://dashscope.aliyuncs.com
LLM_ALLOWED_BASE_URLS=

# --- Frontend (Vite) ---
# Base URL the frontend uses to reach the backend.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_GAZEBO_VIEWER_URL=
# Optional. Example:
# VITE_GAZEBO_VIEWER_URL=https://<pod-id>-6080.proxy.runpod.net/vnc.html?autoconnect=1&resize=scale&view_clip=0

# Optional GUI mode display (demo/debug only), for example :99.
DISPLAY=
# For optional GUI/noVNC demo mode, set PX4_GAZEBO_HEADLESS=false and provide DISPLAY=:99.
# To overlay reference track in Gazebo GUI/noVNC demo mode, also set:
# PX4_GAZEBO_DRAW_TRACK_MARKER=true
PX4_GAZEBO_GUI_WINDOW_TITLE="Gazebo Sim"
GEOMETRY=1600x900x24
PX4_GAZEBO_VNC_DESKTOP_GEOMETRY=1600x900x24
PX4_GAZEBO_GUI_WINDOW_MODE=fill
PX4_GAZEBO_GUI_WINDOW_GEOMETRY=fill
PX4_GAZEBO_GUI_WINDOW_WIDTH=1280
PX4_GAZEBO_GUI_WINDOW_HEIGHT=720
PX4_GAZEBO_GUI_WINDOW_DELAY_SECONDS=8
PX4_GAZEBO_GUI_WINDOW_RETRY_SECONDS=20
PX4_GAZEBO_GUI_WINDOW_ENFORCE_SECONDS=30
PX4_GAZEBO_MARKER_SERVICE=
