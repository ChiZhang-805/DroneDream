# Copy to a local, ignored .env file or inject variables through your secret manager.
# Never commit real values.

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=

# Supabase OAuth client UUID registered for the AUTONOMY loopback callback.
# This is configuration, not an API secret.
DRONEDREAM_OAUTH_CLIENT_ID_AUTONOMY=

# Optional CLI override. From autonomy-core/ the default is ./ros_ws.
DRONEDREAM_AUTONOMY_ROS_WORKSPACE=
