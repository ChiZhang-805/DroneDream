{
  "additionalProperties": false,
  "description": "Stable identity and lifecycle for one user-visible mission conversation.",
  "properties": {
    "active_execution_id": {
      "anyOf": [
        {
          "pattern": "^execution-[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Active Execution Id"
    },
    "conversation_id": {
      "title": "Conversation Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "current_plan_revision_id": {
      "anyOf": [
        {
          "pattern": "^plan-[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Current Plan Revision Id"
    },
    "mission_id": {
      "pattern": "^mission-[0-9a-f]{32}$",
      "title": "Mission Id",
      "type": "string"
    },
    "schema_version": {
      "const": "dronedream.task-thread.v1",
      "default": "dronedream.task-thread.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "enum": [
        "planning",
        "awaiting_confirmation",
        "executing",
        "holding",
        "landing",
        "completed",
        "failed"
      ],
      "title": "State",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "conversation_id",
    "mission_id",
    "state",
    "created_at",
    "updated_at"
  ],
  "title": "TaskThread",
  "type": "object"
}
