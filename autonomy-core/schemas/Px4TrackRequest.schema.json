{
  "$defs": {
    "GraphRoute": {
      "additionalProperties": false,
      "properties": {
        "all_edges_flight_verified": {
          "title": "All Edges Flight Verified",
          "type": "boolean"
        },
        "edge_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 10000,
          "title": "Edge Ids",
          "type": "array"
        },
        "goal_node": {
          "title": "Goal Node",
          "type": "string"
        },
        "node_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Node Ids",
          "type": "array"
        },
        "positions_m": {
          "items": {
            "$ref": "#/$defs/Vector3"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Positions M",
          "type": "array"
        },
        "route_length_m": {
          "minimum": 0.0,
          "title": "Route Length M",
          "type": "number"
        },
        "schema_version": {
          "const": "dronedream.graph-route.v1",
          "default": "dronedream.graph-route.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "start_node": {
          "title": "Start Node",
          "type": "string"
        }
      },
      "required": [
        "start_node",
        "goal_node",
        "node_ids",
        "edge_ids",
        "positions_m",
        "route_length_m",
        "all_edges_flight_verified"
      ],
      "title": "GraphRoute",
      "type": "object"
    },
    "Vector3": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "z": {
          "title": "Z",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "title": "Vector3",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "route": {
      "$ref": "#/$defs/GraphRoute"
    },
    "schema_version": {
      "const": "dronedream.px4-track-request.v1",
      "default": "dronedream.px4-track-request.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "waypoint_hold_seconds": {
      "default": 0.4,
      "maximum": 30.0,
      "minimum": 0.0,
      "title": "Waypoint Hold Seconds",
      "type": "number"
    }
  },
  "required": [
    "route"
  ],
  "title": "Px4TrackRequest",
  "type": "object"
}
