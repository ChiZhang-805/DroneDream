{
  "additionalProperties": false,
  "properties": {
    "contract_id": {
      "title": "Contract Id",
      "type": "string"
    },
    "conversation_id": {
      "title": "Conversation Id",
      "type": "string"
    },
    "execution_id": {
      "pattern": "^execution-[0-9a-f]{32}$",
      "title": "Execution Id",
      "type": "string"
    },
    "message_id": {
      "pattern": "^runtime-msg-[0-9a-f]{32}$",
      "title": "Message Id",
      "type": "string"
    },
    "mission_id": {
      "pattern": "^mission-[0-9a-f]{32}$",
      "title": "Mission Id",
      "type": "string"
    },
    "plan_revision_id": {
      "pattern": "^plan-[0-9a-f]{32}$",
      "title": "Plan Revision Id",
      "type": "string"
    },
    "schema_version": {
      "const": "dronedream.runtime-user-message.v1",
      "default": "dronedream.runtime-user-message.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "submitted_at": {
      "format": "date-time",
      "title": "Submitted At",
      "type": "string"
    },
    "text": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
    "message_id",
    "conversation_id",
    "mission_id",
    "plan_revision_id",
    "contract_id",
    "execution_id",
    "text",
    "submitted_at"
