{
  "additionalProperties": false,
  "properties": {
    "contract_id": {
      "title": "Contract Id",
      "type": "string"
    },
    "conversation_id": {
      "title": "Conversation Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "execution_id": {
      "pattern": "^execution-[0-9a-f]{32}$",
      "title": "Execution Id",
      "type": "string"
    },
    "mission_id": {
      "pattern": "^mission-[0-9a-f]{32}$",
      "title": "Mission Id",
      "type": "string"
    },
    "plan_revision_id": {
      "pattern": "^plan-[0-9a-f]{32}$",
      "title": "Plan Revision Id",
      "type": "string"
    },
    "prepared_mission_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Prepared Mission Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "dronedream.runtime-control-session.v1",
      "default": "dronedream.runtime-control-session.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "default": "accepting",
      "enum": [
        "accepting",
        "closed"
      ],
      "title": "State",
      "type": "string"
    }
  },
  "required": [
    "conversation_id",
    "mission_id",
    "plan_revision_id",
    "contract_id",
    "execution_id",
    "prepared_mission_sha256",
    "created_at"
  ],
  "title": "RuntimeControlSession",
  "type": "object"
}
