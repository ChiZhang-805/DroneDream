{
  "$defs": {
    "ModelCallRecord": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "maximum": 100,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "call_id": {
          "pattern": "^model-[0-9a-f]{24}$",
          "title": "Call Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "output_schema": {
          "title": "Output Schema",
          "type": "string"
        },
        "output_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Output Sha256",
          "type": "string"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "previous_response_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Response Id"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "response_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Id"
        },
        "role": {
          "enum": [
            "intent_parser",
            "intent_critic",
            "plugin_router",
            "task_decomposer",
            "global_planner",
            "plan_critic",
            "execution_monitor",
            "runtime_message_classifier",
            "completion_verifier",
            "context_summarizer"
          ],
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "const": "dronedream.model-call.v1",
          "default": "dronedream.model-call.v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "call_id",
        "role",
        "attempt",
        "input_sha256",
        "output_sha256",
        "output_schema",
        "provider",
        "model",
        "latency_ms",
        "created_at"
      ],
      "title": "ModelCallRecord",
      "type": "object"
    },
    "PluginHookReceipt": {
      "additionalProperties": false,
      "description": "Hash-bound evidence for a non-tool Harness extension invocation.",
      "properties": {
        "capability_id": {
          "title": "Capability Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "hook": {
          "pattern": "^[a-z][a-z0-9._-]{1,95}$",
          "title": "Hook",
          "type": "string"
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "invocation_id": {
          "pattern": "^hook-[0-9a-f]{24}$",
          "title": "Invocation Id",
          "type": "string"
        },
        "issue_codes": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Issue Codes",
          "type": "array"
        },
        "outcome": {
          "enum": [
            "accepted",
            "skipped",
            "failed"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "output_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Output Sha256",
          "type": "string"
        },
        "plugin_id": {
          "title": "Plugin Id",
          "type": "string"
        },
        "plugin_package_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plugin Package Sha256",
          "type": "string"
        },
        "plugin_version": {
          "title": "Plugin Version",
          "type": "string"
        },
        "schema_version": {
          "const": "dronedream.plugin-hook-receipt.v1",
          "default": "dronedream.plugin-hook-receipt.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "slot_id": {
          "title": "Slot Id",
          "type": "string"
        }
      },
      "required": [
        "invocation_id",
        "plugin_id",
        "plugin_version",
        "plugin_package_sha256",
        "capability_id",
        "slot_id",
        "hook",
        "outcome",
        "input_sha256",
        "output_sha256",
        "created_at"
      ],
      "title": "PluginHookReceipt",
      "type": "object"
    },
    "RuntimeAssessment": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "accept",
            "retry",
            "replan",
            "hold",
            "abort"
          ],
          "title": "Action",
          "type": "string"
        },
        "issue_codes": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Issue Codes",
          "type": "array"
        },
        "repair_hint": {
          "anyOf": [
            {
              "maxLength": 400,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repair Hint"
        },
        "schema_version": {
          "const": "dronedream.runtime-assessment.v1",
          "default": "dronedream.runtime-assessment.v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "title": "RuntimeAssessment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assessment": {
      "$ref": "#/$defs/RuntimeAssessment"
    },
    "continue_authorized": {
      "title": "Continue Authorized",
      "type": "boolean"
    },
    "model_call": {
      "$ref": "#/$defs/ModelCallRecord"
    },
    "plugin_hook_receipts": {
      "items": {
        "$ref": "#/$defs/PluginHookReceipt"
      },
      "title": "Plugin Hook Receipts",
      "type": "array"
    },
    "request_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "dronedream.runtime-checkpoint-decision.v1",
      "default": "dronedream.runtime-checkpoint-decision.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "request_sha256",
    "assessment",
    "model_call",
    "continue_authorized"
  ],
  "title": "RuntimeCheckpointDecision",
  "type": "object"
}
