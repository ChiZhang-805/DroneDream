{
  "additionalProperties": false,
  "description": "Sanitized evidence for a core-mediated plugin I/O operation.",
  "properties": {
    "byte_count": {
      "default": 0,
      "minimum": 0,
      "title": "Byte Count",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "issue_codes": {
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "title": "Issue Codes",
      "type": "array"
    },
    "operation": {
      "enum": [
        "filesystem.read",
        "filesystem.write",
        "network.request",
        "credential.inject",
        "process.spawn"
      ],
      "title": "Operation",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "accepted",
        "denied",
        "failed"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "plugin_id": {
      "title": "Plugin Id",
      "type": "string"
    },
    "resource_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Resource Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "dronedream.capability-broker-receipt.v1",
      "default": "dronedream.capability-broker-receipt.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "plugin_id",
    "operation",
    "outcome",
    "resource_sha256"
  ],
  "title": "CapabilityBrokerReceipt",
  "type": "object"
}
