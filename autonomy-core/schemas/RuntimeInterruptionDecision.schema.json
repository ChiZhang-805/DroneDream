{
  "$defs": {
    "ModelCallRecord": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "maximum": 100,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "call_id": {
          "pattern": "^model-[0-9a-f]{24}$",
          "title": "Call Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "output_schema": {
          "title": "Output Schema",
          "type": "string"
        },
        "output_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Output Sha256",
          "type": "string"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "previous_response_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Response Id"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "response_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Id"
        },
        "role": {
          "enum": [
            "intent_parser",
            "intent_critic",
            "plugin_router",
            "task_decomposer",
            "global_planner",
            "plan_critic",
            "execution_monitor",
            "runtime_message_classifier",
            "completion_verifier",
            "context_summarizer"
          ],
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "const": "dronedream.model-call.v1",
          "default": "dronedream.model-call.v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "call_id",
        "role",
        "attempt",
        "input_sha256",
        "output_sha256",
        "output_schema",
        "provider",
        "model",
        "latency_ms",
        "created_at"
      ],
      "title": "ModelCallRecord",
      "type": "object"
    },
    "PluginHookReceipt": {
      "additionalProperties": false,
      "description": "Hash-bound evidence for a non-tool Harness extension invocation.",
      "properties": {
        "capability_id": {
          "title": "Capability Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "hook": {
          "pattern": "^[a-z][a-z0-9._-]{1,95}$",
          "title": "Hook",
          "type": "string"
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "invocation_id": {
          "pattern": "^hook-[0-9a-f]{24}$",
          "title": "Invocation Id",
          "type": "string"
        },
        "issue_codes": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Issue Codes",
          "type": "array"
        },
        "outcome": {
          "enum": [
            "accepted",
            "skipped",
            "failed"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "output_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Output Sha256",
          "type": "string"
        },
        "plugin_id": {
          "title": "Plugin Id",
          "type": "string"
        },
        "plugin_package_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plugin Package Sha256",
          "type": "string"
        },
        "plugin_version": {
          "title": "Plugin Version",
          "type": "string"
        },
        "schema_version": {
          "const": "dronedream.plugin-hook-receipt.v1",
          "default": "dronedream.plugin-hook-receipt.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "slot_id": {
          "title": "Slot Id",
          "type": "string"
        }
      },
      "required": [
        "invocation_id",
        "plugin_id",
        "plugin_version",
        "plugin_package_sha256",
        "capability_id",
        "slot_id",
        "hook",
        "outcome",
        "input_sha256",
        "output_sha256",
        "created_at"
      ],
      "title": "PluginHookReceipt",
      "type": "object"
    },
    "RuntimeAmendmentDirective": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "pattern": "^[a-z][a-z0-9._-]{1,63}$",
          "title": "Action",
          "type": "string"
        },
        "issue_codes": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Issue Codes",
          "type": "array"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "requires_core_authorization": {
          "default": true,
          "title": "Requires Core Authorization",
          "type": "boolean"
        },
        "requires_plan_revision": {
          "default": true,
          "title": "Requires Plan Revision",
          "type": "boolean"
        },
        "requires_stable_hold": {
          "default": true,
          "title": "Requires Stable Hold",
          "type": "boolean"
        },
        "schema_version": {
          "const": "dronedream.runtime-amendment-directive.v1",
          "default": "dronedream.runtime-amendment-directive.v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "title": "RuntimeAmendmentDirective",
      "type": "object"
    },
    "RuntimeMessageClassification": {
      "additionalProperties": false,
      "properties": {
        "message_kind": {
          "enum": [
            "emergency_stop",
            "mission_amendment",
            "motion_adjustment",
            "informational"
          ],
          "title": "Message Kind",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "requested_action": {
          "enum": [
            "land",
            "replan",
            "adjust_motion",
            "resume",
            "redirect",
            "set_speed",
            "pause",
            "return_home",
            "safe_land",
            "set_return_point",
            "set_coverage",
            "camera_control",
            "payload_control",
            "set_avoidance",
            "follow_target",
            "operator_takeover"
          ],
          "title": "Requested Action",
          "type": "string"
        },
        "requires_plan_revision": {
          "title": "Requires Plan Revision",
          "type": "boolean"
        },
        "schema_version": {
          "const": "dronedream.runtime-message-classification.v1",
          "default": "dronedream.runtime-message-classification.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "summary": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "target_entity": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Entity"
        }
      },
      "required": [
        "message_kind",
        "requested_action",
        "requires_plan_revision",
        "summary"
      ],
      "title": "RuntimeMessageClassification",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "amendment_directive": {
      "anyOf": [
        {
          "$ref": "#/$defs/RuntimeAmendmentDirective"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "authorization_gates": {
      "additionalProperties": {
        "type": "boolean"
      },
      "maxProperties": 32,
      "minProperties": 1,
      "title": "Authorization Gates",
      "type": "object"
    },
    "authorized_action": {
      "enum": [
        "resume_original",
        "hold",
        "hold_for_replan",
        "apply_command",
        "land"
      ],
      "title": "Authorized Action",
      "type": "string"
    },
    "classification": {
      "$ref": "#/$defs/RuntimeMessageClassification"
    },
    "decision_reason": {
      "maxLength": 400,
      "minLength": 1,
      "title": "Decision Reason",
      "type": "string"
    },
    "hold_ack_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Hold Ack Sha256",
      "type": "string"
    },
    "message_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Message Sha256",
      "type": "string"
    },
    "model_call": {
      "$ref": "#/$defs/ModelCallRecord"
    },
    "plugin_hook_receipts": {
      "items": {
        "$ref": "#/$defs/PluginHookReceipt"
      },
      "title": "Plugin Hook Receipts",
      "type": "array"
    },
    "schema_version": {
      "const": "dronedream.runtime-interruption-decision.v1",
      "default": "dronedream.runtime-interruption-decision.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "message_sha256",
    "hold_ack_sha256",
    "classification",
    "model_call",
    "authorized_action",
    "authorization_gates",
    "decision_reason"
  ],
  "title": "RuntimeInterruptionDecision",
  "type": "object"
}
