{
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "camera_control",
        "payload_control",
        "set_avoidance"
      ],
      "title": "Action",
      "type": "string"
    },
    "adopted_at": {
      "format": "date-time",
      "title": "Adopted At",
      "type": "string"
    },
    "artifact_kind": {
      "const": "runtime-command",
      "default": "runtime-command",
      "title": "Artifact Kind",
      "type": "string"
    },
    "command_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Command Sha256",
      "type": "string"
    },
    "execution_id": {
      "pattern": "^execution-[0-9a-f]{32}$",
      "title": "Execution Id",
      "type": "string"
    },
    "message_id": {
      "pattern": "^runtime-msg-[0-9a-f]{32}$",
      "title": "Message Id",
      "type": "string"
    },
    "observed_result": {
      "additionalProperties": true,
      "title": "Observed Result",
      "type": "object"
    },
    "result_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Result Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "dronedream.runtime-command-adoption.v1",
      "default": "dronedream.runtime-command-adoption.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "success": {
      "const": true,
      "default": true,
      "title": "Success",
      "type": "boolean"
    }
  },
  "required": [
    "message_id",
    "execution_id",
    "action",
    "command_sha256",
    "result_sha256",
    "observed_result",
    "adopted_at"
  ],
  "title": "RuntimeCommandAdoption",
  "type": "object"
}
