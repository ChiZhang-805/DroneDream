      "type": "string"
    },
    "authorized_actions": {
      "items": {
        "maxLength": 120,
        "minLength": 3,
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
        "type": "string"
      },
      "maxItems": 256,
      "minItems": 2,
      "title": "Authorized Actions",
      "type": "array"
    },
    "constraints": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "title": "Constraints",
      "type": "array"
    },
    "contract_id": {
      "pattern": "^mission-[0-9a-f]{24}$",
      "title": "Contract Id",
      "type": "string"
    },
    "conversation_id": {
      "title": "Conversation Id",
      "type": "string"
    },
    "domain_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "title": "Domain Ids",
      "type": "array"
    },
    "goal": {
      "title": "Goal",
      "type": "string"
    },
    "immutable_safety_rules": {
      "items": {
        "type": "string"
      },
