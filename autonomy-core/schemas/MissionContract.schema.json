    },
    "map_asset_id": {
      "title": "Map Asset Id",
      "type": "string"
    },
    "map_semantic_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Map Semantic Sha256",
      "type": "string"
    },
    "map_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Map Sha256",
      "type": "string"
    },
    "payload_action": {
      "maxLength": 120,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Payload Action",
      "type": "string"
    },
    "return_node": {
      "title": "Return Node",
      "type": "string"
    },
    "schema_version": {
      "const": "dronedream.mission-contract.v1",
