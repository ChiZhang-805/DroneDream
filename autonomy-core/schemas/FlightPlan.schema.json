{
  "$defs": {
    "PlanSegment": {
      "additionalProperties": false,
      "properties": {
        "from_node": {
          "title": "From Node",
          "type": "string"
        },
        "minimum_clearance_m": {
          "exclusiveMinimum": 0.0,
          "maximum": 100.0,
          "title": "Minimum Clearance M",
          "type": "number"
        },
        "path": {
          "items": {
            "$ref": "#/$defs/RoutePoint"
          },
          "maxItems": 1000,
          "minItems": 2,
          "title": "Path",
          "type": "array"
        },
        "segment_id": {
          "pattern": "^segment-[0-9]{3}$",
          "title": "Segment Id",
          "type": "string"
        },
        "speed_limit_mps": {
          "exclusiveMinimum": 0.0,
          "maximum": 20.0,
          "title": "Speed Limit Mps",
          "type": "number"
        },
        "success_evidence": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Success Evidence",
          "type": "array"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "to_node": {
          "title": "To Node",
          "type": "string"
        }
      },
      "required": [
        "segment_id",
        "task_id",
        "from_node",
        "to_node",
        "path",
        "speed_limit_mps",
        "minimum_clearance_m",
        "success_evidence"
      ],
      "title": "PlanSegment",
      "type": "object"
    },
    "RoutePoint": {
      "additionalProperties": false,
      "properties": {
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "position_m": {
          "$ref": "#/$defs/Vector3"
        }
      },
      "required": [
        "node_id",
        "position_m"
      ],
      "title": "RoutePoint",
      "type": "object"
    },
    "Vector3": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "z": {
          "title": "Z",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "title": "Vector3",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_id": {
      "title": "Contract Id",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": "dronedream.flight-plan.v1",
      "default": "dronedream.flight-plan.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/PlanSegment"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Segments",
      "type": "array"
    },
    "semantic_plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Semantic Plan Sha256",
      "type": "string"
    }
  },
  "required": [
    "revision",
    "contract_id",
    "segments",
    "semantic_plan_sha256"
  ],
  "title": "FlightPlan",
  "type": "object"
}
