{
  "additionalProperties": false,
  "properties": {
    "accepted": {
      "title": "Accepted",
      "type": "boolean"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "current_state": {
      "enum": [
        "discovered",
        "staged",
        "installed",
        "starting",
        "healthy",
        "draining",
        "disabled",
        "failed",
        "quarantined",
        "uninstalled"
      ],
      "title": "Current State",
      "type": "string"
    },
    "issue_codes": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "title": "Issue Codes",
      "type": "array"
    },
    "operation": {
      "enum": [
        "install",
        "enable",
        "disable",
        "healthcheck",
        "update",
        "activate",
        "rollback",
        "uninstall",
        "quarantine",
        "trust-local-package",
        "revoke-package"
      ],
      "title": "Operation",
      "type": "string"
    },
    "package_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Package Sha256",
      "type": "string"
    },
    "plugin_id": {
      "title": "Plugin Id",
      "type": "string"
    },
    "previous_state": {
      "anyOf": [
        {
          "enum": [
            "discovered",
            "staged",
            "installed",
            "starting",
            "healthy",
            "draining",
            "disabled",
            "failed",
            "quarantined",
            "uninstalled"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous State"
    },
    "receipt_id": {
      "pattern": "^plugin-event-[0-9a-f]{24}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "schema_version": {
      "const": "dronedream.plugin-lifecycle-receipt.v1",
      "default": "dronedream.plugin-lifecycle-receipt.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "plugin_id",
    "version",
    "operation",
    "current_state",
    "accepted",
    "package_sha256",
    "created_at"
  ],
  "title": "PluginLifecycleReceipt",
  "type": "object"
}
