{
  "$defs": {
    "Vector3": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "z": {
          "title": "Z",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "title": "Vector3",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "detected_at": {
      "format": "date-time",
      "title": "Detected At",
      "type": "string"
    },
    "detection_latency_ms": {
      "minimum": 0,
      "title": "Detection Latency Ms",
      "type": "integer"
    },
    "deterministic_gates": {
      "additionalProperties": {
        "type": "boolean"
      },
      "maxProperties": 32,
      "minProperties": 1,
      "title": "Deterministic Gates",
      "type": "object"
    },
    "execution_id": {
      "pattern": "^execution-[0-9a-f]{32}$",
      "title": "Execution Id",
      "type": "string"
    },
    "frozen_command_ned_m": {
      "$ref": "#/$defs/Vector3"
    },
    "hold_command_ned_m": {
      "$ref": "#/$defs/Vector3"
    },
    "interrupted_phase": {
      "enum": [
        "TAKEOFF",
        "TRACK",
        "CHECKPOINT"
      ],
      "title": "Interrupted Phase",
      "type": "string"
    },
    "message_id": {
      "pattern": "^runtime-msg-[0-9a-f]{32}$",
      "title": "Message Id",
      "type": "string"
    },
    "message_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Message Sha256",
      "type": "string"
    },
    "observed_position_ned_m": {
      "$ref": "#/$defs/Vector3"
    },
    "observed_velocity_ned_mps": {
      "$ref": "#/$defs/Vector3"
    },
    "position_error_m": {
      "minimum": 0.0,
      "title": "Position Error M",
      "type": "number"
    },
    "schedule_index": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Schedule Index"
    },
    "schema_version": {
      "const": "dronedream.runtime-hold-ack.v1",
      "default": "dronedream.runtime-hold-ack.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "side_effects_inhibited": {
      "const": true,
      "default": true,
      "title": "Side Effects Inhibited",
      "type": "boolean"
    },
    "speed_mps": {
      "minimum": 0.0,
      "title": "Speed Mps",
      "type": "number"
    },
    "stabilization_latency_ms": {
      "minimum": 0,
      "title": "Stabilization Latency Ms",
      "type": "integer"
    },
    "stable_at": {
      "format": "date-time",
      "title": "Stable At",
      "type": "string"
    }
  },
  "required": [
    "message_sha256",
    "message_id",
    "execution_id",
    "interrupted_phase",
    "detected_at",
    "detection_latency_ms",
    "stable_at",
    "stabilization_latency_ms",
    "frozen_command_ned_m",
    "hold_command_ned_m",
    "observed_position_ned_m",
    "observed_velocity_ned_mps",
    "position_error_m",
    "speed_mps",
    "deterministic_gates"
  ],
  "title": "RuntimeHoldAcknowledgement",
  "type": "object"
}
