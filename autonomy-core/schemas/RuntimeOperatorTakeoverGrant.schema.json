{
  "additionalProperties": false,
  "description": "One-time, hash-bound authority for bounded manual velocity commands.",
  "properties": {
    "decision_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Decision Sha256",
      "type": "string"
    },
    "deterministic_gates": {
      "additionalProperties": {
        "type": "boolean"
      },
      "maxProperties": 32,
      "minProperties": 1,
      "title": "Deterministic Gates",
      "type": "object"
    },
    "execution_id": {
      "pattern": "^execution-[0-9a-f]{32}$",
      "title": "Execution Id",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "grant_token_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Grant Token Sha256",
      "type": "string"
    },
    "hold_ack_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Hold Ack Sha256",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "maximum_horizontal_speed_mps": {
      "exclusiveMinimum": 0.0,
      "maximum": 3.0,
      "title": "Maximum Horizontal Speed Mps",
      "type": "number"
    },
    "maximum_vertical_speed_mps": {
      "exclusiveMinimum": 0.0,
      "maximum": 2.0,
      "title": "Maximum Vertical Speed Mps",
      "type": "number"
    },
    "maximum_yaw_rate_dps": {
      "exclusiveMinimum": 0.0,
      "maximum": 180.0,
      "title": "Maximum Yaw Rate Dps",
      "type": "number"
    },
    "message_id": {
      "pattern": "^runtime-msg-[0-9a-f]{32}$",
      "title": "Message Id",
      "type": "string"
    },
    "message_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Message Sha256",
      "type": "string"
    },
    "operator_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Operator Id",
      "type": "string"
    },
    "schema_version": {
      "const": "dronedream.runtime-operator-takeover-grant.v1",
      "default": "dronedream.runtime-operator-takeover-grant.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "message_id",
    "execution_id",
    "operator_id",
    "message_sha256",
    "hold_ack_sha256",
    "decision_sha256",
    "grant_token_sha256",
    "maximum_horizontal_speed_mps",
    "maximum_vertical_speed_mps",
    "maximum_yaw_rate_dps",
    "deterministic_gates",
    "issued_at",
    "expires_at"
  ],
  "title": "RuntimeOperatorTakeoverGrant",
  "type": "object"
}
