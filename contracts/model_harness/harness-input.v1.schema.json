{
  "$id": "urn:dronedream:schema:model-harness:input:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Structured, owner-bound input presented to one Harness responsibility.",
  "properties": {
    "control_plane_selection_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Control Plane Selection Sha256",
      "type": "string"
    },
    "current_request": {
      "additionalProperties": true,
      "title": "Current Request",
      "type": "object"
    },
    "domain": {
      "enum": [
        "optimization.control_tuning",
        "autonomy.mission",
        "asset.qualification",
        "experiment.simulation",
        "workflow.cross_edition",
        "validation.hardware",
        "calibration.system",
        "transfer.sim_to_real",
        "transfer.real_to_sim",
        "operations.field"
      ],
      "title": "Domain",
      "type": "string"
    },
    "memory_record_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "title": "Memory Record Ids",
      "type": "array"
    },
    "owner_binding_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Owner Binding Sha256",
      "type": "string"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 8,
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "dronedream.model-harness-input.v1",
      "default": "dronedream.model-harness-input.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "session_context": {
      "additionalProperties": true,
      "title": "Session Context",
      "type": "object"
    },
    "source_edition": {
      "enum": [
        "universal",
        "sim",
        "lab",
        "field",
        "autonomy"
      ],
      "title": "Source Edition",
      "type": "string"
    },
    "task_id": {
      "maxLength": 128,
      "minLength": 8,
      "title": "Task Id",
      "type": "string"
    },
    "tenant_binding_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Tenant Binding Sha256",
      "type": "string"
    },
    "thread_id": {
      "maxLength": 128,
      "minLength": 8,
      "title": "Thread Id",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "task_id",
    "thread_id",
    "owner_binding_sha256",
    "tenant_binding_sha256",
    "source_edition",
    "domain",
    "control_plane_selection_sha256",
    "current_request"
  ],
  "title": "HarnessInputEnvelope",
  "type": "object"
}
