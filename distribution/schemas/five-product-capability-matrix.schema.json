{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getdronedream.com/schemas/five-product-capability-matrix.schema.json",
  "title": "DroneDream five-product capability matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "matrixVersion", "productCount", "sharedEngineeringPatterns", "products"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "dronedream-five-product-capability-matrix"},
    "matrixVersion": {"const": "1.0.0"},
    "productCount": {"const": 5},
    "sharedEngineeringPatterns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["autonomyPageInEveryProduct", "accountAllowanceAndUpdateShell", "structuredInputAndOutput", "repeatedModelCalls", "iterativeValidationLoops", "pluginizedHarnessAndTools", "safeInterruptReplanAndEvidenceGates", "llmDirectActuationAllowed"],
      "properties": {
        "autonomyPageInEveryProduct": {"const": true},
        "accountAllowanceAndUpdateShell": {"const": true},
        "structuredInputAndOutput": {"const": true},
        "repeatedModelCalls": {"const": true},
        "iterativeValidationLoops": {"const": true},
        "pluginizedHarnessAndTools": {"const": true},
        "safeInterruptReplanAndEvidenceGates": {"const": true},
        "llmDirectActuationAllowed": {"const": false}
      }
    },
    "products": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["productId", "displayName", "branch", "primaryPurpose", "executionDomains", "navigationSections", "experimentRole", "conversationRole", "autonomyRole", "hardwareAuthority"],
        "properties": {
          "productId": {"enum": ["universal", "sim", "lab", "field", "autonomy"]},
          "displayName": {"type": "string", "minLength": 1},
          "branch": {"enum": ["codex/software", "codex/software-sim", "codex/software-lab", "codex/software-field", "codex/software-agent"]},
          "primaryPurpose": {"type": "string", "minLength": 1},
          "executionDomains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "navigationSections": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "experimentRole": {"type": "string", "minLength": 1},
          "conversationRole": {"type": "string", "minLength": 1},
          "autonomyRole": {"type": "string", "minLength": 1},
          "hardwareAuthority": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
