{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dronedream.local/schemas/component-update-catalog.v1.json",
  "title": "DroneDream signed component update catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "catalogSequence", "generatedAt", "expiresAt", "components"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "dronedream-component-update-catalog"},
    "catalogSequence": {"type": "integer", "minimum": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "components": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "componentId", "version", "releaseSequence", "policy", "packId",
          "editionProfiles", "manifest", "archive"
        ],
        "properties": {
          "componentId": {"enum": ["capability-pack", "asset-pack"]},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "releaseSequence": {"type": "integer", "minimum": 1},
          "policy": {"enum": ["recommended", "required"]},
          "packId": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "editionProfiles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {"enum": ["unified-sim-lab", "sim-only", "field-lightweight"]}
          },
          "manifest": {"$ref": "#/$defs/artifact"},
          "archive": {"$ref": "#/$defs/artifact"}
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sizeBytes", "sha256"],
      "properties": {
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "sizeBytes": {"type": "integer", "minimum": 1, "maximum": 4294967296},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
