  "optionAnalysis": [
    {
      "optionId": "reuse-canonical-node-modules-by-direct-junction",
      "disposition": "rejected-as-default",
      "advantages": [
        "no dependency copy",
        "normal npm and Node resolution"
      ],
      "blockers": [
        "current canonical node_modules has no source-bound manifest",
        "shared mutable worktree dependencies can drift during an Edition build",
        "target is inside another Git worktree rather than an Edition-owned dependency root"
      ]
    },
    {
      "optionId": "explicit-dependency-root-via-path-or-direct-cli-only",
      "disposition": "insufficient-alone",
      "advantages": [
        "no junction",
        "Tauri CLI entrypoint can be explicit"
      ],
      "blockers": [
        "PATH resolves binaries but does not reliably bind frontend ESM imports to an external node_modules tree",
        "Tauri beforeBuildCommand runs the source frontend package and needs normal package resolution"
      ]
    },
    {
      "optionId": "npm-ci-offline-inside-detached-source",
      "disposition": "not-preferred-for-release-build",
      "advantages": [
        "native npm resolution",
        "lockfile-driven install"
      ],
      "blockers": [
        "dependency lifecycle execution and large writes occur inside the exact-source worktree",
        "installation becomes part of the same one-shot build attempt",
        "ignored node_modules can evade ordinary postbuild status reporting without a dedicated manifest"
      ],
      "allowedOnlyAsSeparateProvisioningStageAfterYellowAuthorization": true
    },
    {
      "optionId": "attested-external-bundle-with-two-allowlisted-junctions",
      "disposition": "recommended",
      "advantages": [
        "normal desktop and frontend Node resolution is preserved",
        "dependency bytes live in a repo-external Edition-neutral owned root",
        "one immutable source/lock-bound bundle can be reused by all four Editions"
      ],
      "requiredJunctions": [
        {
          "linkRelativeToDetachedSource": "desktop/node_modules",
          "targetRelativeToDependencyRoot": "desktop/node_modules"
        },
        {
          "linkRelativeToDetachedSource": "frontend/node_modules",
          "targetRelativeToDependencyRoot": "frontend/node_modules"
        }
      ]
    }
  ],
