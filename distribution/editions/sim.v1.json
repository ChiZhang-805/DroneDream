{
  "schemaVersion": 1,
  "kind": "dronedream-edition-manifest",
  "editionId": "sim",
  "editionVersion": "1.0.0",
  "productDisplayVersion": "1.0.0",
  "displayName": {
    "en": "DroneDream Sim",
    "zh-CN": "DroneDream 纯仿真版"
  },
  "description": {
    "en": "Simulation-only PX4 SITL, Gazebo, and Harness workflows with physical hardware actions denied below the UI.",
    "zh-CN": "仅运行 PX4 SITL、Gazebo 与 Harness；所有真机和 HITL 操作都在前端以下强制拒绝。"
  },
  "implementationStatus": "integrated-contract",
  "validationTier": "sim-runtime-contract",
  "artifactBaseName": "DroneDream-Sim-1.0.0.exe",
  "capabilityPolicy": {
    "policyId": "core-capabilities",
    "policyVersion": "1.0.0",
    "sha256": "ff15182466b2adf5e5134009096c55a6e110f8af2c247818735facc17874ccc3"
  },
  "modules": {
    "required": [
      "desktop-core",
      "engine-pack",
      "runtime-core",
      "runtime-simulation",
      "simulator-gazebo-harmonic",
      "simulator-px4-sitl",
      "vehicle-pack-sim",
      "vehicle-pack-validation"
    ],
    "optional": [],
    "forbidden": [
      "hardware-bridge",
      "qgroundcontrol-external",
      "vehicle-pack-hardware"
    ]
  },
  "capabilities": {
    "enabledOrConditioned": [
      "qualification.simulation.issue",
      "simulation.execute",
      "simulation.parameter.write",
      "simulation.vehicle.arm",
      "updater.module.apply",
      "vehicle-pack.install"
    ],
    "forbidden": [
      "external.qgroundcontrol.launch",
      "hardware.arm",
      "hardware.discover",
      "hardware.emergency-stop",
      "hardware.flight",
      "hardware.hitl.execute",
      "hardware.parameter.read",
      "hardware.parameter.write",
      "hardware.preflight.execute",
      "qualification.trusted.consume"
    ]
  },
  "runtimeProfile": {
    "profileId": "full-simulation",
    "currentAvailability": "integrated-contract",
    "includesLargeSimulator": true
  },
  "qualification": {
    "mayIssueSimulationReceipt": true,
    "mayConsumeTrustedReceipt": false,
    "hardwareActionRule": "not-applicable",
    "receiptCompatibilityFailClosed": true
  },
  "sourcePolicy": {
    "developmentBranch": "codex/software-sim",
    "integrationBranch": "main",
    "editionSourceDivergenceAllowed": false,
    "hotfixMustReturnToCore": true,
    "commonCoreHashRequired": true
  },
  "releaseChannel": {
    "branch": "codex/software-sim",
    "creationState": "long-lived-product-branch",
    "promotionManifestRequired": true,
    "forcePushAllowed": false
  },
  "knownGaps": [
    "This source manifest does not attest a particular installer; release acceptance requires an exact external build receipt, checksum, updater signature, and headed edition-identity validation.",
    "Physical hardware modules are excluded from the compiled SIM command surface, while backend and Runtime capability policy must continue to deny every real-aircraft target."
  ]
}
