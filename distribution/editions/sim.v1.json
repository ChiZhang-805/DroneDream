    "includesLargeSimulator": true
  },
  "qualification": {
    "mayIssueSimulationReceipt": true,
    "mayConsumeTrustedReceipt": false,
    "hardwareActionRule": "not-applicable",
    "receiptCompatibilityFailClosed": true
  },
  "sourcePolicy": {
    "developmentBranch": "codex/software",
    "integrationBranch": "main",
    "editionSourceDivergenceAllowed": false,
    "hotfixMustReturnToCore": true,
    "commonCoreHashRequired": true
  },
  "releaseChannel": {
    "branch": "codex/release-sim",
    "creationState": "planned-not-created",
    "promotionManifestRequired": true,
    "forcePushAllowed": false
