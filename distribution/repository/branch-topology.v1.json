{
  "schemaVersion": 1,
  "kind": "dronedream-public-branch-topology",
  "topologyVersion": "1.1.0",
  "requiredBranchCount": 8,
  "branches": [
    {"name": "main", "role": "protected-integration", "productId": null},
    {"name": "software", "role": "long-lived-product", "productId": "universal"},
    {"name": "software-sim", "role": "long-lived-product", "productId": "sim"},
    {"name": "software-lab", "role": "long-lived-product", "productId": "lab"},
    {"name": "software-field", "role": "long-lived-product", "productId": "field"},
    {"name": "software-agent", "role": "long-lived-product", "productId": "autonomy"},
    {"name": "website", "role": "long-lived-delivery", "productId": "website"},
    {"name": "technical-report", "role": "long-lived-delivery", "productId": "technical-report"}
  ],
  "policy": {
    "featureBranchesTemporary": true,
    "deleteFeatureBranchOnlyAfterMerged": true,
    "forcePushAllowed": false,
    "commonCoreChangesReturnToMain": true,
    "sharedProductChangesPropagateThroughPullRequests": true,
    "privateAutonomyDevelopmentMayRunInParallel": true
  }
}
