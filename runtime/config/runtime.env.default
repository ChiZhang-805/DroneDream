APP_ENV=desktop
AUTH_MODE=oidc_jwt
OIDC_ISSUER=https://yggabfynndpzymlqvnim.supabase.co/auth/v1
OIDC_AUDIENCE=authenticated
OIDC_JWKS_URL=https://yggabfynndpzymlqvnim.supabase.co/auth/v1/.well-known/jwks.json
OIDC_ALGORITHMS=ES256
DATABASE_URL=sqlite:////var/lib/dronedream/dronedream.db
DATABASE_AUTO_CREATE=false
SQLITE_BUSY_TIMEOUT_SECONDS=30
REDIS_URL=redis://127.0.0.1:6379/0
REQUIRE_WORKER_HEARTBEAT=true
WORKER_PRESENCE_INTERVAL_SECONDS=5
WORKER_PRESENCE_TTL_SECONDS=30
APP_SECRET_KEY=__APP_SECRET_KEY__
DRONEDREAM_RUNTIME_ID=__RUNTIME_ID__
ARTIFACT_STORAGE_BACKEND=local
ARTIFACT_ROOT=/var/lib/dronedream/artifacts
REAL_SIMULATOR_ARTIFACT_ROOT=/var/lib/dronedream/artifacts
ARTIFACT_CLEANUP_ENABLED=true
ARTIFACT_CLEANUP_DRY_RUN=false
ARTIFACT_CLEANUP_INTERVAL_SECONDS=3600
ARTIFACT_RETENTION_MAX_TOTAL_BYTES=12884901888
ARTIFACT_RETENTION_MAX_AGE_SECONDS=2592000
ARTIFACT_RETENTION_MIN_AGE_SECONDS=86400
ARTIFACT_RETENTION_KEEP_RECENT_TERMINAL_JOBS=10
ARTIFACT_ORPHAN_GRACE_SECONDS=86400
# Empty means each job chooses mock or real_cli; this must not be globally forced.
SIMULATOR_BACKEND=
REAL_SIMULATOR_COMMAND="/opt/dronedream/venv/bin/python /opt/dronedream/source/scripts/simulators/px4_gazebo_runner.py"
REAL_SIMULATOR_TIMEOUT_SECONDS=1200
REAL_SIMULATOR_KEEP_RUN_DIRS=false
PX4_GAZEBO_DRY_RUN=false
PX4_GAZEBO_HEADLESS=true
PX4_GAZEBO_LAUNCH_GUI_CLIENT=false
PX4_GAZEBO_DRAW_TRACK_MARKER=false
PX4_GAZEBO_TIMEOUT_SECONDS=900
PX4_GAZEBO_WORKDIR=/opt/dronedream/source
PX4_GAZEBO_LAUNCH_COMMAND="/opt/dronedream/venv/bin/python /opt/dronedream/source/scripts/simulators/local_px4_launch_wrapper.py --run-dir {run_dir} --input {trial_input} --params {params_json} --px4-params {px4_params_json} --track {track_json} --telemetry {telemetry_json} --stdout-log {stdout_log} --stderr-log {stderr_log} --vehicle {vehicle} --airframe {airframe} --simulator-model {simulator_model} --world {world} --px4-version {px4_version} --headless {headless}"
PX4_AUTOPILOT_DIR=/opt/PX4-Autopilot
PX4_SETUP_COMMANDS="source /opt/dronedream/venv/bin/activate"
PX4_PARAMETER_TRANSPORT=environment
PX4_TELEMETRY_MODE=ulog
PX4_ULOG_ROOT=/opt/PX4-Autopilot/build/px4_sitl_default/rootfs/log
PX4_ENABLE_OFFBOARD_EXECUTOR=true
PX4_OFFBOARD_EXECUTOR_COMMAND="/opt/dronedream/venv/bin/python /opt/dronedream/source/scripts/simulators/px4_offboard_track_executor.py"
DRONEDREAM_PX4_EXECUTABLE=/opt/PX4-Autopilot/build/px4_sitl_default/bin/px4
DRONEDREAM_GAZEBO_EXECUTABLE=/usr/bin/gz
