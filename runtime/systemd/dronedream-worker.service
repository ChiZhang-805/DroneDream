[Unit]
Description=DroneDreamRuntime PX4/Gazebo worker
After=dronedream-api.service valkey.service dronedream-runtime-init.service
Requires=valkey.service dronedream-runtime-init.service

[Service]
Type=simple
User=dronedream
Group=dronedream
EnvironmentFile=/etc/dronedream/runtime.env
WorkingDirectory=/opt/dronedream/source
ExecStart=/opt/dronedream/venv/bin/drone-dream-worker
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/dronedream /opt/PX4-Autopilot/build /home/dronedream /tmp

[Install]
WantedBy=multi-user.target
