* text=auto

.gitattributes text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
backend/evaluation_artifacts/*.csv text eol=lf
backend/evaluation_artifacts/*.sha256 text eol=lf
*.rs text eol=lf
*.nsh text eol=lf
*.sh text eol=lf
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary

/runtime/** text eol=lf
/scripts/**/*.sh text eol=lf
/.github/workflows/*.yml text eol=lf
/desktop/scripts/*.ps1 text eol=lf
/desktop/src-tauri/nsis/*.nsi text eol=lf
/desktop/src-tauri/nsis/*.nsh text eol=lf

# The locked corpus hash is defined over the committed LF byte stream.
/backend/tests/fixtures/harness_routing_policy_holdout_v1.jsonl text eol=lf

# Frozen evidence is content-addressed over exact bytes.
/artifacts/technical-report/* -text -diff
/artifacts/test-runs/* -text -diff
