{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DroneDream-Lab",
  "identifier": "io.dronedream.desktop.lab",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DroneDream · LAB",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "publisher": "DroneDream",
    "shortDescription": "DroneDream · LAB internal unsigned preview",
    "longDescription": "DroneDream · LAB is the bidirectional Sim-to-Real and Real-to-Sim calibration workspace. Model proposals and Harness experiments remain bounded by native, backend, runtime, Vehicle Pack, and operator safety gates.",
    "icon": [
      "../../brand/generated/lab/windows/32x32.png",
      "../../brand/generated/lab/windows/128x128.png",
      "../../brand/generated/lab/windows/128x128@2x.png",
      "../../brand/generated/lab/windows/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "../../brand/generated/lab/windows/icon.ico",
        "uninstallerIcon": "../../brand/generated/lab/windows/icon.ico"
      }
    },
    "resources": {
      "../../distribution/build-profiles/lab-preview.v1.json": "distribution/lab-preview.v1.json",
      "../../distribution/editions/lab.v1.json": "distribution/editions/lab.v1.json",
      "../../distribution/capabilities/core-capabilities.v1.json": "distribution/capabilities/core-capabilities.v1.json",
      "../../distribution/safety/edition-execution-gate.v1.json": "distribution/safety/edition-execution-gate.v1.json",
      "../../distribution/vehicle-packs/registry.v1.json": "distribution/vehicle-packs/registry.v1.json",
      "../../distribution/editions/lab/brand-source-manifest.v1.json": "distribution/editions/lab/brand-source-manifest.v1.json",
      "../../distribution/editions/lab/coexistence-and-auth.v1.json": "distribution/editions/lab/coexistence-and-auth.v1.json",
      "../../distribution/editions/lab/universal-donor-requests.v1.json": "distribution/editions/lab/universal-donor-requests.v1.json",
      "../../distribution/editions/lab/safety-oauth-source-readiness.v1.json": "distribution/editions/lab/safety-oauth-source-readiness.v1.json",
      "../../distribution/editions/lab/model-harness-closed-loop.v1.json": "distribution/editions/lab/model-harness-closed-loop.v1.json",
      "../../distribution/editions/lab/sim-field-integration.v1.json": "distribution/editions/lab/sim-field-integration.v1.json",
      "../../distribution/editions/lab/field-2f8fa285-capability-sync.v1.json": "distribution/editions/lab/field-2f8fa285-capability-sync.v1.json",
      "../../distribution/editions/field/field-tuning-contract.v1.json": "distribution/editions/field/field-tuning-contract.v1.json",
      "../../distribution/editions/field/adapters/THIRD_PARTY_NOTICES.md": "distribution/editions/field/adapters/THIRD_PARTY_NOTICES.md",
      "../../distribution/editions/field/adapters/catalog.v1.json": "distribution/editions/field/adapters/catalog.v1.json",
      "../../distribution/editions/field/adapters/packages": "distribution/editions/field/adapters/packages",
      "../../distribution/schemas/field-adapter-catalog.schema.json": "distribution/schemas/field-adapter-catalog.schema.json",
      "../../distribution/desktop/edition-coexistence.v1.json": "distribution/desktop/edition-coexistence.v1.json",
      "../../distribution/schemas/desktop-edition-coexistence.schema.json": "distribution/schemas/desktop-edition-coexistence.schema.json",
      "../../distribution/desktop/edition-browser-auth.v1.json": "distribution/desktop/edition-browser-auth.v1.json",
      "../../distribution/schemas/desktop-edition-browser-auth.schema.json": "distribution/schemas/desktop-edition-browser-auth.schema.json",
      "../../distribution/desktop/edition-runtime-update-families.v1.json": "distribution/desktop/edition-runtime-update-families.v1.json",
      "../../distribution/schemas/desktop-edition-runtime-update-families.schema.json": "distribution/schemas/desktop-edition-runtime-update-families.schema.json",
      "../../distribution/editions/lab/assets/dronedream-lab-mark-v2.png": "distribution/editions/lab/assets/dronedream-lab-mark-v2.png",
      "../../brand/generated/lab/lockup-compact.png": "brand/generated/lab/lockup-compact.png",
      "../../brand/brand-editions.v1.json": "brand/brand-editions.v1.json",
      "../../brand/generated/brand-assets.v1.json": "brand/generated/brand-assets.v1.json",
      "../../brand/generated/brand-visual-receipt.v1.json": "brand/generated/brand-visual-receipt.v1.json"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ChiZhang-805/DroneDream/releases/download/desktop-lab-channel/latest-lab.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
