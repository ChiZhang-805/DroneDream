{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core permissions for the DroneDream main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://getdronedream.com/pricing/"
        },
        {
          "url": "https://binhu7.github.io/courses/ECE498/Spring2025/ECE498home.html"
        }
      ]
    }
  ]
}
