{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DroneDream-Field",
  "identifier": "io.dronedream.desktop.field",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DroneDream · FIELD",
        "width": 1440,
        "height": 900,
        "minWidth": 390,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "publisher": "DroneDream",
    "shortDescription": "Real-device operations and bounded field tuning",
    "longDescription": "DroneDream · FIELD is the lightweight real-device workspace for read-only discovery, evidence review, snapshots, bounded tuning plans, preflight and recovery. It contains no simulation surface and starts with zero validated hardware packs.",
    "icon": [
      "../../brand/generated/field/windows/32x32.png",
      "../../brand/generated/field/windows/128x128.png",
      "../../brand/generated/field/windows/128x128@2x.png",
      "../../brand/generated/field/windows/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "../../brand/generated/field/windows/icon.ico",
        "uninstallerIcon": "../../brand/generated/field/windows/icon.ico"
      }
    },
    "resources": {
      "../../distribution/editions/field.v1.json": "distribution/editions/field.v1.json",
      "../../distribution/editions/field/field-tuning-contract.v1.json": "distribution/editions/field/field-tuning-contract.v1.json",
      "../../distribution/editions/field/adapters/THIRD_PARTY_NOTICES.md": "licenses/Field-Adapter-THIRD-PARTY-NOTICES.md",
      "../../distribution/capabilities/core-capabilities.v1.json": "distribution/capabilities/core-capabilities.v1.json",
      "../../distribution/safety/edition-execution-gate.v1.json": "distribution/safety/edition-execution-gate.v1.json",
      "../../distribution/vehicle-packs/registry.v1.json": "distribution/vehicle-packs/registry.v1.json",
      "../../distribution/desktop/edition-coexistence.v1.json": "distribution/desktop/edition-coexistence.v1.json",
      "../../distribution/desktop/edition-browser-auth.v1.json": "distribution/desktop/edition-browser-auth.v1.json",
      "../../distribution/desktop/edition-runtime-update-families.v1.json": "distribution/desktop/edition-runtime-update-families.v1.json",
      "../../brand/brand-editions.v1.json": "brand/brand-editions.v1.json",
      "../../brand/generated/brand-assets.v1.json": "brand/generated/brand-assets.v1.json"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ChiZhang-805/DroneDream/releases/download/desktop-field-channel/latest-field.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
